{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vrg-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "apps/api", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8390"],
      "port": 8390,
      "autoPort": true
    },
    {
      "name": "vrg-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd apps/web && exec node_modules/.bin/vite --port 5390 --host"],
      "port": 5390,
      "autoPort": true
    }
  ]
}
