{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vrg-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "apps/api", "python", "-m", "app"],
      "port": 8390
    },
    {
      "name": "vrg-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "apps/web", "dev"],
      "port": 5390,
      "autoPort": true
    }
  ]
}
