# ─── Sao chép thành deployment/.env và điền giá trị thật (KHÔNG commit .env) ───

# ─── Image ────────────────────────────────────────────────────
VRG_TAG=0.1.0                        # tag image (bắt buộc — KHÔNG dùng latest)

# ─── App ──────────────────────────────────────────────────────
APP_ENV=production
APP_PORT=8390                        # cổng host publish (container FastAPI nội bộ 8000)

# ─── Database (TimescaleDB + pgvector) ────────────────────────
DB_PASSWORD=CHANGE_ME_strong_password
# DATABASE_URL được dựng tự động trong compose từ DB_PASSWORD (host "db").
# Chỉ set DATABASE_URL nếu dùng DB NGOÀI (managed) thay cho service db trong stack:
# DATABASE_URL=postgresql://vrg:PASS@host:5432/vrg_caosu

# ─── Auth admin (JWT) — BẮT BUỘC đổi khi triển khai ───────────
JWT_SECRET=CHANGE_ME_long_random_secret_min_32_bytes
JWT_EXPIRE_MINUTES=720