# ─── Sao chép thành .env và điền giá trị thật (KHÔNG commit .env) ───

# App
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# ─── LLM (Qualitative Block) ──────────────────────────────────
# Dùng hợp đồng Business/Enterprise để bật Zero Data Retention
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
LLM_PROVIDER=anthropic            # anthropic | openai

# ─── Database (TimescaleDB + pgvector) ────────────────────────
DATABASE_URL=postgresql://vrg:CHANGE_ME@localhost:5432/vrg_caosu
PGVECTOR_DIM=1536

# ─── Crawlers (4 sàn quốc tế + vĩ mô) ─────────────────────────
CRAWLER_USER_AGENT=bizino-vrg-bot/1.0
EXCHANGE_RATE_API_KEY=

# ─── Notifications (đa kênh) ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ZALO_OA_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Lịch báo cáo tự động ─────────────────────────────────────
REPORT_MORNING=07:30             # dự báo mở cửa
REPORT_EVENING=17:00             # tổng kết thực tế vs dự báo
