# ─── Sao chép thành .env và điền giá trị thật (KHÔNG commit .env) ───

# App (cổng riêng VRG để tránh trùng project khác)
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8390
WEB_PORT=5390
VITE_API_URL=http://localhost:8390   # web gọi API ở cổng này

# ─── LLM (Qualitative Block) ──────────────────────────────────
# Dùng hợp đồng Business/Enterprise để bật Zero Data Retention
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
LLM_PROVIDER=anthropic            # anthropic | openai

# ─── Database (TimescaleDB + pgvector) ────────────────────────
DB_PORT=5433                         # cổng host (5432 thường đã có Postgres khác)
DATABASE_URL=postgresql://vrg:CHANGE_ME@localhost:5433/vrg_caosu
PGVECTOR_DIM=1536

# ─── Auth admin (JWT) — BẮT BUỘC đổi khi triển khai ───────────
JWT_SECRET=CHANGE_ME_long_random_secret_min_32_bytes
JWT_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME            # mật khẩu admin seed lần đầu (mặc định dev: admin)

# ─── Crawlers (4 sàn quốc tế + vĩ mô) ─────────────────────────
CRAWLER_USER_AGENT=bizino-vrg-bot/1.0
EXCHANGE_RATE_API_KEY=
LGM_AUTH=                            # để trống = dùng token Basic công khai nhúng trong frontend LGM
MARKETSCREENER_USER=                 # tài khoản marketscreener (nguồn giá physical Asian rubber)
MARKETSCREENER_PASS=
# MARKETSCREENER_PROXY=http://user:pass@host:port   # tùy chọn — proxy RESIDENTIAL khi IP bị Akamai chặn

# ─── Notifications (đa kênh) ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ZALO_OA_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Lịch báo cáo tự động ─────────────────────────────────────
REPORT_MORNING=07:30             # dự báo mở cửa
REPORT_EVENING=17:00             # tổng kết thực tế vs dự báo
