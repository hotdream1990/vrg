<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Lịch chạy hằng ngày 18:30 (sau khi Reuters phát hành bài "Asian physical rubber prices").
  Đường dẫn TUYỆT ĐỐI phải khớp vị trí repo (sửa nếu repo ở nơi khác).
  Cài:  cp infra/launchd/com.vrg.marketscreener.plist ~/Library/LaunchAgents/
        launchctl load ~/Library/LaunchAgents/com.vrg.marketscreener.plist
  Gỡ:   launchctl unload ~/Library/LaunchAgents/com.vrg.marketscreener.plist
  Lưu ý: repo nằm trên volume mount (/Volumes/Work) → cần volume đã mount khi job chạy.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vrg.marketscreener</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Volumes/Work/biz-project/VRG/scripts/cron/daily-marketscreener.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>18</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Volumes/Work/biz-project/VRG/data/marketscreener-cron.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/Work/biz-project/VRG/data/marketscreener-cron.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
